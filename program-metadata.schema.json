{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cryptostylematrix.github.io/frontend/program-metadata.schema.json",
  "title": "Crypto Style Marketing Program Metadata",
  "description": "Metadata exposed through a Marketing V3 program metadata_uri.",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "format": "uri-reference"
    },
    "creator": {
      "$ref": "#/$defs/creator"
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "platforms": {
      "type": "integer",
      "minimum": 0
    },
    "entry": {
      "$ref": "#/$defs/entry"
    },
    "incomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/income"
      }
    },
    "presentations": {
      "$ref": "#/$defs/presentations"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "creator": {
      "type": "object",
      "properties": {
        "tg": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": [
        "price",
        "currency"
      ],
      "properties": {
        "price": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "fixed",
            "minimum"
          ],
          "default": "minimum"
        }
      },
      "additionalProperties": true
    },
    "income": {
      "type": "object",
      "required": [
        "period",
        "value",
        "currency"
      ],
      "properties": {
        "period": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "minimum",
            "maximum"
          ],
          "default": "maximum"
        }
      },
      "additionalProperties": true
    },
    "presentations": {
      "type": "object",
      "properties": {
        "pdf": {
          "$ref": "#/$defs/localizedLinks"
        },
        "video": {
          "$ref": "#/$defs/localizedLinks"
        }
      },
      "additionalProperties": true
    },
    "localizedLinks": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "format": "uri-reference"
      }
    }
  }
}
